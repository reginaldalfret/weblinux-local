  },
  "integrity": {
    "chunksCount": 8192
  },
  "runtimeRequirements": {
    "minMemoryMB": 4096,
    "recommendedMemoryMB": 8192,
    "minCores": 4,
    "recommendedCores": 8,
    "requiresSharedArrayBuffer": true,
    "requiresCrossOriginIsolated": true,
    "requiresWebGL2": true,
    "requiresOPFS": true,
    "estimatedDiskMB": 2200
  },
  "licensing": {
    "baseLicense": "GPL-2.0-or-later, Fedora Project Guidelines",
    "redistributionAllowed": true,
    "licenseDocUrl": "/docs/LICENSING.md"
  },
  "validationStatus": "experimental",
  "notes": "Experimental port. Fedora RISC-V minimal image undergoing userspace NOMMU testing."
}
