{
  "id": "fedora",
  "name": "Fedora Linux (RISC-V Port)",
  "releaseVersion": "41",
  "architecture": "riscv64",
  "kernelCompatibility": "linux-wasm64_nommu-6.1",
  "defaultDesktop": "icewm",
  "supportedDesktops": ["icewm", "kde-plasma"],
  "packageManager": "dnf",
  "filesystemLayout": {
    "rootMount": "/fedora",
    "homeMount": "/home/fedora"
  },
  "imageSource": {
    "baseUri": "/images/fedora/",
    "chunkSize": 1048576,
    "totalSizeBytes": 8589934592,
